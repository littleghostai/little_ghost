<%#
# Key: tools/validation/schema/type
# Purpose: Schema type validation feedback.
# Used: Returned to the model when LittleGhost produces schema type validation feedback.
# Locals:
# - path: Path or validation location referenced by the prompt.
# - types: Allowed JSON Schema types.
# Constraints:
# - Must render non-blank.
-%>
<%= path %> must be <%= types.join(" or ") %>
