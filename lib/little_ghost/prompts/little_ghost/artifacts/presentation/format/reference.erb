<%#
# Key: artifacts/presentation/format/reference
# Purpose: Artifact reference line.
# Used: Inserted into larger model-visible content as the artifact reference line.
# Locals:
# - reference: Model-visible artifact reference.
# - media_type: Artifact media type.
# - bytes: Artifact size in bytes.
# Constraints:
# - Must render non-blank.
# - This output is embedded inside a larger model-visible message.
-%>
<%= reference %> (<%= [media_type, "#{bytes} bytes"].compact.join(", ") %>)
